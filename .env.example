STARROCKS_HOST=localhost
STARROCKS_PORT=9030
STARROCKS_USER=root
STARROCKS_PASSWORD=
STARROCKS_DATABASE=security_lakehouse
STARROCKS_CONNECT_TIMEOUT_SECONDS=5
# Set these for a managed or third-party StarRocks deployment that requires TLS.
STARROCKS_SSL_ENABLED=false
STARROCKS_SSL_VERIFY=true
# STARROCKS_SSL_CA=/run/secrets/starrocks-ca.pem
RULES_PATH=rules/default.yaml
# HNSW is currently a StarRocks beta feature and must be enabled per cluster.
VECTOR_SEARCH_ENABLED=true
VECTOR_DIMENSION=64
# Enable only in a disposable demo environment.
DEMO_ENABLED=false

# Optional server-side Chat Completions-compatible LLM (OpenAI, Qwen, vLLM, etc.).
LLM_ENABLED=false
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

# Optional comma-separated API keys for third-party REST callers. When unset,
# /v1 remains open for local development only. Put this behind HTTPS and a
# gateway in production.
INTEGRATION_API_KEYS=
